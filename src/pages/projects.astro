---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { projects } from "@/data/projects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.projectsTitle} | ${config.site.title}`}
  description={config.site.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.projectsTitle}>
    {
      projects.length === 0 ? (
        <p>{t.pages.projectsEmpty}</p>
      ) : (
        <ul>
          {projects.map(project => (
            <li class="my-6">
              <a
                href={project.href}
                class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
              >
                {project.name}
              </a>
              <p>{project.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
